# ===================================================================
# HireRanker - Environment Variables & Local Setup Example
# ===================================================================
# Copy these environment variables or set them in your OS / IDE:
#
# DB_USERNAME=root
# DB_PASSWORD=your_mysql_password
# SERVER_PORT=8080
#
# Optional AI Services (System operates with built-in fallbacks if omitted):
# OPENROUTER_API_KEY=your_openrouter_api_key
# GROQ_API_KEY=your_groq_api_key
# RESEND_API_KEY=your_resend_api_key
#
# Frontend URL:
# FRONTEND_URL=http://localhost:4200
